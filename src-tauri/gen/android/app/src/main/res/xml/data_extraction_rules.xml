<?xml version="1.0" encoding="utf-8"?>
<!-- BYOD: nothing of Maintafox leaves the phone through cloud backup or device transfer (Android 12+).
     The encrypted database is useless without the Keystore key, which never migrates anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
