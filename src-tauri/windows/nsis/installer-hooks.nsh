; ============================================================================
; Maintafox NSIS installer hooks (tauri.conf.json -> bundle.windows.nsis.installerHooks).
;
; Tauri includes this file near the top of the generated installer script, before
; any wizard page is declared, so the MUI_* settings made here (and in
; branding.nsh) are picked up by the pages Tauri declares afterwards. No
; install-time behaviour is changed: the NSIS_HOOK_* macros are intentionally not
; defined, and the "Delete the application data" check box, shortcuts and registry
; handling stay exactly as generated by Tauri.
;
; Do not declare pages (MUI_PAGE_* / MUI_UNPAGE_*) in this file: the first page
; declaration freezes the MUI interface settings (icon, header image) that Tauri
; defines later in the script.
; ============================================================================

!include "${__FILEDIR__}\branding.nsh"

; Uninstaller confirmation page text (consumed by Tauri's MUI_UNPAGE_CONFIRM).
!define MUI_UNCONFIRMPAGE_TEXT_TOP "$(brandUnConfirmText)"

; Installer Welcome / Finish page wording (consumed by Tauri's MUI_PAGE_WELCOME / MUI_PAGE_FINISH).
!define MUI_WELCOMEPAGE_TITLE "$(brandWelcomeTitle)"
!define MUI_WELCOMEPAGE_TEXT "$(brandWelcomeText)"
!define MUI_FINISHPAGE_TITLE "$(brandFinishTitle)"
!define MUI_FINISHPAGE_TEXT "$(brandFinishText)"
!define MUI_FINISHPAGE_RUN_TEXT "$(brandRunApp)"
